# Copy to .deploy.stage.env and .deploy.prod.env, one per server
# (make deploy DEPLOY_ENV=prod; stage is the default). The app's own
# secrets go in .stage.env and .prod.env (copies of .env.example).

# Server: any Debian 13 host that accepts your ed25519 key for root
DEPLOY_HOST=123.123.123.123
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_SSH_PORT=22
# User of the first `make host_first`
# DEPLOY_BOOTSTRAP_USER=root

# Who may open monitor.<domain> (space separated IPs or CIDRs) and how to log in
MONITOR_ALLOW_IPS="123.123.123.123 234.234.234.234/24"
DOZZLE_USER=ops
DOZZLE_PASSWORD=change-me

# Database replica on any S3 compatible storage (token with access to this bucket only).
# Only needed when litestream is on in infra/ansible/host_vars/<env>.yml
LITESTREAM_ENDPOINT=https://<account>.s3.server.com
LITESTREAM_BUCKET=dwb-courses-db
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Dead man's switch (healthchecks.io: period 10m, grace 10m)
LITESTREAM_HEARTBEAT_URL=https://ping.com/<uuid>
