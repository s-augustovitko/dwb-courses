{
	admin off
	# Config comes from this file, the autosave copy is never read
	persist_config off

	# Cloudflare ranges from https://www.cloudflare.com/ips/
	# {client_ip} is CF-Connecting-IP only when the request comes from them
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Hosts come from caddy.env, so one image serves every environment
{$APP_HOST} {
	encode

	# Max Request body size
	request_body {
		max_size 4MiB
	}

	# handle, not respond: handle runs first
	@hidden {
		path */.*
	}
	handle @hidden {
		respond 403
	}

	handle /api/v1/* {
		# Only the real client IP: the API reads the right-most public one
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Vite hashes /assets names, index.html must revalidate
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @shell Cache-Control "no-cache"
		@shell not path /assets/*

		header {
			# frame-ancestors is 'self': Culqi never frames our page, our page frames Culqi.
			# No form-action: the 3DS step may POST forms to the card bank's own host.
			Content-Security-Policy "default-src 'self'; script-src 'self' https://js.culqi.com https://3ds.culqi.com https://checkout.culqi.com; frame-src https://*.culqi.com; connect-src 'self' https://*.culqi.com; img-src 'self' data: https://*.culqi.com; font-src 'self' https://*.culqi.com; style-src 'self' 'unsafe-inline' https://*.culqi.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
		}
	}
}

# Dozzle, allowed IPs in caddy.env
{$MONITOR_HOST} {
	@denied not client_ip {$MONITOR_ALLOW_IPS:127.0.0.1}
	abort @denied
	encode

	reverse_proxy 127.0.0.1:8080
}
