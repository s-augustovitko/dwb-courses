# Fails (and retries) if the replica is unreachable, so the api never boots on
# an empty database.
[Unit]
Description=Restore main.db from the replica if missing

[Container]
Image={{ litestream_image }}
Exec=restore -if-db-not-exists -if-replica-exists /data/main.db
EnvironmentFile=%h/app/secrets/litestream.env
Volume=%h/infra/litestream.yml:/etc/litestream.yml:ro
Volume=%h/app/data:/data
Network=dwb.network
UserNS=keep-id:uid=1001,gid=1001
User=1001
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory=256m

[Service]
Type=oneshot
Restart=on-failure
RestartSec=15s
